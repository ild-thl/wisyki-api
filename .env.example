# Wisyki API
ROOT_PATH=/

# Host ports for the local development services
HOST_PORT=7680
POSTGRES_PORT=5432
PGADMIN_PORT=5050
CHROMA_HOST_PORT=8000
HF_TEXT_INF_PORT=8081

# PostgreSQL
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=my_secure_pgadmin_password

# Database (used by the API to connect to PostgreSQL)
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=wisyki-skills
DB_USERNAME=root
DB_PASSWORD=my_secure_db_password

# LLM (OpenAI-compatible endpoint - set to your own provider and model)
LLM_API_URL=https://chat-ai.academiccloud.de/v1
LLM_MODEL=gemma-3-27b-it
LLM_API_KEY=xxx

# Chroma vector database
CHROMA_HOST=chroma
CHROMA_PORT=8000
CHROMA_COLLECTION=wisyki-skills
CHROMA_DATABASE=wisyki
CHROMA_TENANT=default_tenant
CHROMA_SERVER_AUTHN_CREDENTIALS=secret-token
CHROMA_SERVER_AUTHN_PROVIDER=chromadb.auth.token_authn.TokenAuthenticationServerProvider

# HuggingFace Embedding API (embedding server)
HF_EMBEDDING_HOST=http://hf-text-inf
HF_EMBEDDING_API_KEY=xxx
# Model served by the local text-embeddings-inference service
HF_EMBEDDING_MODEL=isy-thl/multilingual-e5-base-learning-outcome-skill-tuned
# Optional metadata task models. Empty overrides inherit LLM_MODEL/API_URL/API_KEY.
# Validation prefers LLM_MODEL_COMPLEX when set; legacy competent-model calls do too.
LLM_MODEL_COMPLEX=
LLM_EXTRACTION_MODEL=
LLM_VALIDATION_MODEL=
LLM_SUMMARY_MODEL=
LLM_TRANSLATION_MODEL=
LLM_EXTRACTION_API_URL=
LLM_VALIDATION_API_URL=
LLM_SUMMARY_API_URL=
LLM_TRANSLATION_API_URL=
LLM_EXTRACTION_API_KEY=
LLM_VALIDATION_API_KEY=
LLM_SUMMARY_API_KEY=
LLM_TRANSLATION_API_KEY=

# Metadata endpoint limits. json_object requires provider support; prompt is portable.
ELM_LOQ_METADATA_RESPONSE_FORMAT=prompt
ELM_LOQ_METADATA_VALIDATION_BATCH_SIZE=24
ELM_LOQ_METADATA_VALIDATION_MAX_INPUT_CHARS=24000
ELM_LOQ_METADATA_LLM_CONCURRENCY=2
ELM_LOQ_METADATA_LLM_REQUESTS_PER_WINDOW=2
ELM_LOQ_METADATA_LLM_RATE_WINDOW_SECONDS=10
ELM_LOQ_METADATA_LLM_RATE_LIMIT_BUCKET=
ELM_LOQ_METADATA_SYNC_RATE_WAIT_SECONDS=30
ELM_LOQ_METADATA_MAX_SYNC_REQUESTS=20
ELM_LOQ_METADATA_MAX_PENDING_JOBS=100
ELM_LOQ_METADATA_JOB_RETENTION_SECONDS=86400
ELM_LOQ_METADATA_JOB_LEASE_SECONDS=180
ELM_LOQ_METADATA_WORKER_CONCURRENCY=1
ELM_LOQ_METADATA_JOB_TIMEOUT_SECONDS=3600
