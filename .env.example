# Wisyki API
ROOT_PATH=/

# Host ports for the services exposed by docker-compose
HOST_PORT=7680
POSTGRES_PORT=5432
PGADMIN_PORT=5050
CHROMA_PORT=8000
HF_TEXT_INF_PORT=8081

# PostgreSQL
POSTGRES_PASSWORD=my_secure_db_password
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=my_secure_pgadmin_password

# Database (used by the API to connect to PostgreSQL)
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=wisyki-skills
DB_USERNAME=root
DB_PASSWORD=my_secure_db_password

# LLM (OpenAI-compatible endpoint - set to your own provider and model)
LLM_API_URL=https://chat-ai.academiccloud.de/v1
LLM_MODEL=gemma-3-27b-it
LLM_API_KEY=xxx

# Chroma vector database
CHROMA_HOST=chroma
CHROMA_PORT=8000
CHROMA_COLLECTION=wisyki-skills
CHROMA_DATABASE=wisyki
CHROMA_TENANT=default_tenant
CHROMA_SERVER_AUTHN_CREDENTIALS=secret-token
CHROMA_SERVER_AUTHN_PROVIDER=chromadb.auth.token_authn.TokenAuthenticationServerProvider

# HuggingFace Embedding API (embedding server)
HF_EMBEDDING_HOST=http://hf-text-inf
HF_EMBEDDING_API_KEY=xxx
# Model served by the local text-embeddings-inference service
HF_EMBEDDING_MODEL=isy-thl/multilingual-e5-base-learning-outcome-skill-tuned